/* =========================
   MAIN CONTACTS PAGE
   ========================= */

/* Page */
.main-page {
    min-height: 100vh;
    width: 100%;
}

/* =========================
   HEADER
   ========================= */

.main-header {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 40px;
}

.main-header .logo {
    width: 220px;
    height: auto;
}

.user-section {
    display: flex;
    align-items: center;
    gap: 15px;
}

.welcome-message {
    font-weight: bold;
}

/* =========================
   MAIN CONTENT
   ========================= */
/* MERCENARY TABLE */

.table-container {
    width: 100%;

    overflow-x: auto;

    border: 1px solid #555555;
    border-radius: 10px;
}

.mercenary-table {
    width: 100%;

    border-collapse: collapse;

    background-color: #3A3A3A;
}

.mercenary-table th,
.mercenary-table td {
    padding: 15px 18px;

    text-align: left;
    vertical-align: middle;

    border-bottom: 1px solid #555555;
}

.mercenary-table th {
    background-color: #2C2C2C;

    font-weight: 700;
    font-size: 0.95rem;
}

.mercenary-table td {
    font-size: 0.95rem;
}

.mercenary-table tbody tr:hover {
    background-color: #444444;
}

.mercenary-table tbody tr:last-child td {
    border-bottom: none;
}

.main-container {
    width: 90%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 30px 0 50px;
}

.main-container h1,
.main-container h2 {
    text-align: center;
}

/* =========================
   SEARCH / FILTERS
   ========================= */

.search-section {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    margin: 25px 0;
}

.search-section input {
    flex: 1;
    min-width: 250px;
    padding: 12px 15px;
    border: 2px solid #000000;
    border-radius: 10px;
    font-size: 16px;
}

.search-section select {
    padding: 12px 15px;
    border: 2px solid #000000;
    border-radius: 10px;
    font-size: 16px;
}

/* =========================
   ACTIONS
   ========================= */

.contact-actions {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin: 20px 0;
}

/* =========================
   CONTACTS
   ========================= */

.contacts-container {
    width: 100%;
    margin-top: 30px;
}

.contact-list {
    display: grid;
    grid-template-columns: repeat(
        auto-fit,
        minmax(280px, 1fr)
    );
    gap: 20px;
}

.contact-card {
    background-color: #4a4a4a;
    border: 2px solid #000000;
    border-radius: 15px;
    padding: 20px;
    box-shadow: 0 5px 12px rgba(0, 0, 0, 0.3);
}

.contact-card h3 {
    margin-top: 0;
    margin-bottom: 15px;
}

.contact-card p {
    margin: 8px 0;
}

/* Buttons inside contact cards */
.contact-buttons {
    display: flex;
    gap: 10px;
    margin-top: 15px;
}

.contact-buttons button {
    flex: 1;
}

/* =========================
   ADD / EDIT CONTACT
   ========================= */

.contact-form-container {
    width: 100%;
    max-width: 600px;
    margin: 30px auto;
    padding: 30px;

    background-color: #4a4a4a;
    border: 2px solid #000000;
    border-radius: 20px;

    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
}

.contact-form-container h2 {
    text-align: center;
    margin-top: 0;
}

.contact-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.contact-form input,
.contact-form select {
    width: 100%;
    padding: 12px 15px;
    border: 2px solid #000000;
    border-radius: 10px;
    font-size: 16px;
}

/* =========================
   MESSAGES
   ========================= */

.error-message {
    color: #ff6b6b;
    text-align: center;
    margin: 15px 0;
}

.success-message {
    color: #7cff7c;
    text-align: center;
    margin: 15px 0;
}

/* =========================
   MOBILE
   ========================= */

@media (max-width: 700px) {

    .main-header {
        flex-direction: column;
        gap: 15px;
        padding: 20px;
        text-align: center;
    }

    .main-header .logo {
        width: 190px;
    }

    .user-section {
        flex-direction: column;
    }

    .main-container {
        width: 95%;
    }

    .search-section {
        flex-direction: column;
    }

    .search-section input,
    .search-section select {
        width: 100%;
    }

    .contact-actions {
        flex-direction: column;
    }

    .contact-form-container {
        padding: 20px;
    }
}
